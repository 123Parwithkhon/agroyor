# Локально: PGlite (файл в .data/pglite). В продакшене — строка подключения Neon:
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=pglite://.data/pglite

# Порт локального PGlite-сервера (только для pglite://)
PGLITE_PORT=5433

# Админ, которого создаёт npm run db:seed (телефон в любом формате +992...)
ADMIN_PHONE=+992900000000
ADMIN_PASSWORD=change-me-please

# next-auth (этап 2): сгенерировать — node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Vercel Blob (этап 3)
BLOB_READ_WRITE_TOKEN=
